<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro de Entrega de Ayuda - Sistema de Gestión</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body class="bg-light">

    <!-- Navbar Institucional -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand" href="#"><i class="bi bi-hospital me-2"></i>Comisión Permanente de Salud</a>
            <span class="navbar-text text-white-50 small">Sistema de Gestión Institucional</span>
        </div>
    </nav>

    <!-- Contenedor Principal -->
    <div class="container my-4">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-box-seam me-2"></i>Registro de Entrega de Ayuda</h5>
                        <a href="index.html" class="btn btn-sm btn-light"><i class="bi bi-arrow-left me-1"></i>Volver</a>
                    </div>
                    <div class="card-body">
                        <form id="formEntregaAyuda">
                            <input type="hidden" id="entregaIdCaso" name="entregaIdCaso">
                            
                            <div class="row g-3">
                                <!-- Datos del Beneficiario / Expediente -->
                                <div class="col-md-6">
                                    <label for="cedulaBeneficiario" class="form-label">Cédula del Beneficiario</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="cedulaBeneficiario" required placeholder="Ej: V-12345678">
                                        <button class="btn btn-outline-secondary" type="button" id="btnBuscarCaso">
                                            <i class="bi bi-search"></i> Buscar
                                        </button>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label for="nombreBeneficiario" class="form-label">Nombre y Apellido</label>
                                    <input type="text" class="form-control" id="nombreBeneficiario" readonly required placeholder="Debe buscar el expediente...">
                                </div>

                                <!-- Detalles de la Ayuda -->
                                <div class="col-md-6">
                                    <label for="tipoAyuda" class="form-label">Tipo de Ayuda Entregada</label>
                                    <select class="form-select" id="tipoAyuda" required>
                                        <option value="">Seleccione...</option>
                                        <option value="Medicina">Medicamentos</option>
                                        <option value="Ayuda Tecnica">Ayuda Técnica (Silla de ruedas, bastón, etc.)</option>
                                        <option value="Alimento">Alimentos / Kit Comida</option>
                                        <option value="Insumo Medico">Insumo Médico-Quirúrgico</option>
                                        <option value="Otro">Otro</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label for="descripcionInsumo" class="form-label">Descripción Detallada del Insumo / Beneficio</label>
                                    <input type="text" class="form-control" id="descripcionInsumo" placeholder="Ej: Glibenclamida 5mg / Silla de ruedas estándar" required>
                                </div>

                                <div class="col-md-4">
                                    <label for="cantidadAyuda" class="form-label">Cantidad</label>
                                    <input type="number" class="form-control" id="cantidadAyuda" min="1" value="1" required>
                                </div>

                                <div class="col-md-4">
                                    <label for="fechaEntrega" class="form-label">Fecha de Entrega</label>
                                    <input type="date" class="form-control" id="fechaEntrega" required>
                                </div>

                                <div class="col-md-4">
                                    <label for="responsableEntrega" class="form-label">Responsable de la Entrega</label>
                                    <input type="text" class="form-control" id="responsableEntrega" required placeholder="Nombre del funcionario">
                                </div>

                                <!-- Observaciones -->
                                <div class="col-12">
                                    <label for="observacionesEntrega" class="form-label">Observaciones / Comprobante (Opcional)</label>
                                    <textarea class="form-control" id="observacionesEntrega" rows="2" placeholder="Detalles de la entrega, número de acta o condición de recepción"></textarea>
                                </div>

                                <!-- Botones de Acción -->
                                <div class="col-12 text-end mt-4">
                                    <button type="reset" class="btn btn-secondary me-2"><i class="bi bi-x-circle me-1"></i>Limpiar</button>
                                    <button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-1"></i>Registrar Entrega</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts del Sistema e Integración SQLite -->
    <script src="js/conexion.js"></script>
    <script>
        // Inicializar la fecha con el día actual por defecto
        document.getElementById('fechaEntrega').valueAsDate = new Date();

        // 1. Buscar el caso social por cédula para asociar la entrega
        document.getElementById('btnBuscarCaso').addEventListener('click', async () => {
            const cedula = document.getElementById('cedulaBeneficiario').value.trim();
            if (!cedula) {
                alert('Por favor ingrese una cédula para buscar.');
                return;
            }

            try {
                const resultado = await consultarBaseDatos(
                    "SELECT id, nombres, apellidos FROM casos_salud WHERE cedula = ? LIMIT 1",
                    [cedula]
                );

                if (resultado && resultado.length > 0) {
                    const caso = resultado[0];
                    document.getElementById('entregaIdCaso').value = caso.id;
                    document.getElementById('nombreBeneficiario').value = `${caso.nombres} ${caso.apellidos}`;
                    alert('¡Beneficiario encontrado y asociado exitosamente!');
                } else {
                    alert('No se encontró ningún caso registrado con esa cédula.');
                    document.getElementById('entregaIdCaso').value = '';
                    document.getElementById('nombreBeneficiario').value = '';
                }
            } catch (error) {
                console.error("Error al buscar el caso:", error);
                alert('Error al consultar la base de datos.');
            }
        });

        // 2. Procesar el envío y guardado en SQLite
        document.getElementById('formEntregaAyuda').addEventListener('submit', async (e) => {
            e.preventDefault();

            const idCaso = document.getElementById('entregaIdCaso').value;
            if (!idCaso) {
                alert('Debe asociar un beneficiario válido antes de registrar la entrega.');
                return;
            }

            const tipoAyuda = document.getElementById('tipoAyuda').value;
            const descripcion = document.getElementById('descripcionInsumo').value;
            const cantidad = document.getElementById('cantidadAyuda').value;
            const fecha = document.getElementById('fechaEntrega').value;
            const responsable = document.getElementById('responsableEntrega').value;
            const observaciones = document.getElementById('observacionesEntrega').value;

            try {
                // Insertar el registro en la tabla de entregas
                const queryEntrega = `
                    INSERT INTO entregas_ayuda (id_caso, tipo_ayuda, descripcion, cantidad, fecha_entrega, responsable, observaciones)
                    VALUES (?, ?, ?, ?, ?, ?, ?)
                `;
                
                await consultarBaseDatos(queryEntrega, [
                    Number(idCaso), tipoAyuda, descripcion, Number(cantidad), fecha, responsable, observaciones
                ]);

                // Actualizar la bitácora del caso social automáticamente reflejando la entrega
                const notaBitacora = `[${fecha}] Entrega de ${cantidad}x ${tipoAyuda} (${descripcion}) por ${responsable}. Obs: ${observaciones}`;
                
                const casoActual = await consultarBaseDatos("SELECT seguimiento_bitacora FROM casos_salud WHERE id = ?", [Number(idCaso)]);
                const bitacoraAnterior = casoActual[0]?.seguimiento_bitacora || "";
                const bitacoraNueva = bitacoraAnterior ? `${bitacoraAnterior}\n${notaBitacora}` : notaBitacora;

                await consultarBaseDatos(
                    "UPDATE casos_salud SET seguimiento_bitacora = ? WHERE id = ?",
                    [bitacoraNueva, Number(idCaso)]
                );

                alert('¡Entrega registrada y bitácora actualizada con éxito en SQLite!');
                document.getElementById('formEntregaAyuda').reset();
                document.getElementById('entregaIdCaso').value = '';
                document.getElementById('fechaEntrega').valueAsDate = new Date();

            } catch (error) {
                console.error("Error al registrar la entrega:", error);
                alert('Hubo un error al procesar el registro de la ayuda.');
            }
        });
    </script>
</body>
</html>
